{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/es",
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/en",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/v2-editorial-dark-blue",
      "destination": "/v2-editorial-dark-blue/",
      "permanent": false
    },
    {
      "source": "/v1-vitrine-dark-neon",
      "destination": "/v1-vitrine-dark-neon/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/layouts/(.*)",
      "destination": "/layouts para sites/$1"
    }
  ]
}
